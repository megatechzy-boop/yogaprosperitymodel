Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# Compression and long-lived caching for versioned static assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(?:css|js|jpg|jpeg|png|gif|webp|avif|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Never expose locally stored lead data from the public website.
RewriteRule ^storage(?:/|$) - [F,L,NC]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^programs/suvarn-sangh(?:\.php)?/?$ programs/ [R=301,L]

RewriteRule ^index/?$ index.php [L]
RewriteRule ^about/?$ about.php [L]
RewriteRule ^yoga-prosperity-method/?$ yoga-prosperity-method.php [L]
RewriteRule ^programs/?$ programs.php [L]
RewriteRule ^programs/(rajat-sangh|suvarn-sangh|vajra-sangh)/?$ programs/$1.php [L]
RewriteRule ^success-stories/?$ success-stories.php [L]
RewriteRule ^resources/(start-online-yoga-business-india|choose-profitable-yoga-niche|package-yoga-signature-program|yoga-teacher-pricing|ethical-yoga-marketing|premium-yoga-clients)/?$ blog.php?article=$1 [QSA,L]
RewriteRule ^resources/?$ blog.php [L]
RewriteRule ^contact/?$ contact.php [L]
RewriteRule ^privacy-policy/?$ privacy-policy.php [L]
RewriteRule ^terms-and-conditions/?$ terms.php [L]
RewriteRule ^refund-policy/?$ refund-policy.php [L]
RewriteRule ^pricing-policy/?$ pricing-policy.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
